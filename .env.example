# Twilio Credentials
# Consigue estos en tu consola de Twilio: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui

# Números de teléfono (Formato E.164: +[código_país][número])
# El número de Twilio debe ser el del Sandbox de WhatsApp (ej: +14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
MAMA_WHATSAPP_NUMBER=whatsapp:+5491122334455

# Seguridad
WEBHOOK_SECRET_TOKEN=tu_token_seguro_para_el_celular_aqui
